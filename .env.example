# Copy to .env.local and fill in.
# One database shared by Stranger Trips and Companion.
MONGODB_URI=mongodb://127.0.0.1:27017/compapp
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# The admin account. The server creates it by itself the first time it starts, and
# leaves it alone if an account with this email already exists.
# ADMIN_EMAIL empty = the default in src/lib/db/admin-seed.ts.
# ADMIN_PASSWORD empty = development makes up a password and prints it in the terminal
# once; production creates no admin until you set one (8+ characters).
ADMIN_EMAIL=codebynidhi1007@gmail.com
ADMIN_PASSWORD=

# Companion phone verification (OTP by SMS). Set ONE provider's keys.
# Leave all empty in development: the code is printed in the terminal and shown on screen.
# Production refuses to sign people up without one.
# SMS_PROVIDER picks one explicitly (twilio | msg91 | fast2sms); empty = whichever has keys.
SMS_PROVIDER=

# Fast2SMS (India only, easiest to start): fast2sms.com > Dev API > API key.
FAST2SMS_API_KEY=

# MSG91 (India, DLT-registered): authkey + an OTP template whose text contains ##OTP##.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Twilio (worldwide).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay: agency plans and traveller seat fees. Dashboard > Account & Settings > API keys.
# Use test keys (rzp_test_...) until you go live.
# Leave empty in development: payments are simulated and no money moves.
# Production refuses to take payments without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks: URL https://<your-domain>/api/payments/razorpay/webhook, event payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Email through SMTP (nodemailer). Used instead of Brevo when both are filled in.
# For Gmail: SMTP_USER is the Gmail address, SMTP_PASS is an APP PASSWORD (not the
# normal password): turn on 2-step verification, then myaccount.google.com/apppasswords.
# Other providers: also set SMTP_HOST and SMTP_PORT (defaults smtp.gmail.com, 465).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
# Optional: the address emails are sent from. Empty = SMTP_USER.
SMTP_FROM=

# Brevo: emails the "verify your email" link. app.brevo.com > SMTP & API > API keys.
# BREVO_SENDER_EMAIL must be a sender you verified in Brevo.
# Leave empty in development: the link is printed in the terminal and shown on screen.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Who is emailed when a Companion profile is waiting for photo verification (commas for
# several). They need an admin account to open /admin/verifications.
# Empty = the default in src/lib/companion/review-request.ts.
VERIFICATION_ADMIN_EMAIL=
# Public address of the site, used for links in emails (e.g. https://example.com).
APP_URL=

# Frontend/backend split (optional): the pages on one host, data and actions on another.
# Set BACKEND_URL only on the FRONTEND deployment, to the backend's address. That deployment
# then needs no MONGODB_URI or provider keys: just these two and the same SESSION_SECRET.
# BACKEND_SECRET is a long random password, set to the same value on both.
BACKEND_URL=
BACKEND_SECRET=
